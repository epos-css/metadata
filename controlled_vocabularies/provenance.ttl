@prefix dct: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://www.opengis.net/def/nil/OGC/0/missing> a skos:Concept ;
    skos:broader <https://www.geodata.rocks/voc/css/provenance/en/top_concept> ;
    skos:definition "The correct value is not readily available to the sender of this data. Furthermore, a correct value may not exist"@en ;
    skos:inScheme <https://www.geodata.rocks/voc/css/provenance> ;
    skos:prefLabel "missing"@en .

<https://www.geodata.rocks/voc/css/provenance/en/analogue> a skos:Concept ;
    skos:broader <https://www.geodata.rocks/voc/css/provenance/en/top_concept> ;
    skos:definition "Analogue data (not digitised)."@en ;
    skos:inScheme <https://www.geodata.rocks/voc/css/provenance> ;
    skos:prefLabel "analogue"@en .

<https://www.geodata.rocks/voc/css/provenance/en/analogue_to_digital> a skos:Concept ;
    skos:broader <https://www.geodata.rocks/voc/css/provenance/en/top_concept> ;
    skos:definition "Digitised analogue recording."@en ;
    skos:inScheme <https://www.geodata.rocks/voc/css/provenance> ;
    skos:prefLabel "analogue to digital"@en .

<https://www.geodata.rocks/voc/css/provenance/en/digital> a skos:Concept ;
    skos:broader <https://www.geodata.rocks/voc/css/provenance/en/top_concept> ;
    skos:definition "Fully digital recording/workflow."@en ;
    skos:inScheme <https://www.geodata.rocks/voc/css/provenance> ;
    skos:prefLabel "digital"@en .

<https://www.geodata.rocks/voc/css/provenance/en/paper> a skos:Concept ;
    skos:altLabel "raster copy"@en ;
    skos:broader <https://www.geodata.rocks/voc/css/provenance/en/top_concept> ;
    skos:definition "Paper printout or scanned paper printout."@en ;
    skos:inScheme <https://www.geodata.rocks/voc/css/provenance> ;
    skos:prefLabel "paper"@en .

<https://www.geodata.rocks/voc/css/provenance/en/paper_to_digital> a skos:Concept ;
    skos:broader <https://www.geodata.rocks/voc/css/provenance/en/top_concept> ;
    skos:definition "Digitised waveforms from scanned paper printout."@en ;
    skos:inScheme <https://www.geodata.rocks/voc/css/provenance> ;
    skos:prefLabel "paper to digital"@en .

<https://www.geodata.rocks/voc/css/provenance> a skos:ConceptScheme ;
    dct:title "Provenance"@en ;
    skos:hasTopConcept <https://www.geodata.rocks/voc/css/provenance/en/top_concept> ;
    skos:prefLabel "Provenance"@en .

<https://www.geodata.rocks/voc/css/provenance/en/top_concept> a skos:Concept ;
    skos:narrower <http://www.opengis.net/def/nil/OGC/0/missing>,
        <https://www.geodata.rocks/voc/css/provenance/en/analogue>,
        <https://www.geodata.rocks/voc/css/provenance/en/analogue_to_digital>,
        <https://www.geodata.rocks/voc/css/provenance/en/digital>,
        <https://www.geodata.rocks/voc/css/provenance/en/paper>,
        <https://www.geodata.rocks/voc/css/provenance/en/paper_to_digital> ;
    skos:prefLabel "Provenance"@en ;
    skos:topConceptOf <https://www.geodata.rocks/voc/css/provenance> .