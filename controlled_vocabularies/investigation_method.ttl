@prefix dct: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://www.geodata.rocks/voc/css/investigation_method/near_surface_seismics> a skos:Concept ;
    skos:broader <https://www.geodata.rocks/voc/css/investigation_method/top_concept> ;
    skos:definition "High-resolution seismics (0.x-5 m spatial spacing) focused on near-surface problems in depth range from 0 to a few hundreds of meters. The resulting data set can be used for reflection imaging, refraction analysis, but also for surface waves disperison analysis Multichannel Analysis of Surface Waves (MASW)."@en ;
    skos:inScheme <https://www.geodata.rocks/voc/css/investigation_method> ;
    skos:prefLabel "near-surface seismic"@en ;
    skos:related <https://www.geodata.rocks/voc/css/investigation_method/multi_channel_analysis_of_surface_waves>,
        <https://www.geodata.rocks/voc/css/investigation_method/seismic_reflection>,
        <https://www.geodata.rocks/voc/css/investigation_method/seismic_refraction> .

<https://www.geodata.rocks/voc/css/investigation_method/wide_angle_reflection_and_refraction> a skos:Concept ;
    skos:altLabel "deep seismic sounding"@en ;
    skos:broader <https://www.geodata.rocks/voc/css/investigation_method/top_concept> ;
    skos:definition "Wide-Angle Reflection and Refraction (WARR) combines the seismic reflection method (<skos:related>) with the seismic refraction method (<skos:related>) for deep investigation of the Earth's structure (Deep Seismic Sounding (DSS); imaging the Earth's crust and upper mantle). It requires long offsets between source and receivers, and a long recording time."@en ;
    skos:inScheme <https://www.geodata.rocks/voc/css/investigation_method> ;
    skos:prefLabel "wide-angle reflection and refraction"@en .

<https://www.geodata.rocks/voc/css/investigation_method/multi_channel_analysis_of_surface_waves> a skos:Concept ;
    skos:broader <https://www.geodata.rocks/voc/css/investigation_method/top_concept> ;
    skos:definition "Multi-channel Analysis of Surface Waves (MASW) is a method for geotechnical applications. It evaluates stiffness and shear-wave velocity of ground materials in a depth range that is of interest in engineering applications."@en,
        "El Análisis Multicanal de Ondas Superficiales (MASW) es un método sísmico no destructivo que caracteriza la rigidez del subsuelo analizando la dispersión de ondas Rayleigh generadas activa o pasivamente. Es ampliamente utilizado en ingeniería civil para determinar el módulo de cizalla, clasificación de suelos, y estudios geotécnicos."@es ;
    skos:inScheme <https://www.geodata.rocks/voc/css/investigation_method> ;
    skos:prefLabel "multi-channel analysis of surface waves"@en,
        "AMOS"@es .

<https://www.geodata.rocks/voc/css/investigation_method/seismic_reflection> a skos:Concept ;
    skos:broader <https://www.geodata.rocks/voc/css/investigation_method/top_concept> ;
    skos:definition "Seismic waves are generated by a controlled source at the surface and travel downwards until their energy is partially reflected at an impedance boundary in the subsurface (e.g. an interface between different rock types). The reflected wave is recorded by a sensor at the surface."@en ;
    skos:inScheme <https://www.geodata.rocks/voc/css/investigation_method> ;
    skos:prefLabel "seismic reflection"@en .

<https://www.geodata.rocks/voc/css/investigation_method/seismic_refraction> a skos:Concept ;
    skos:broader <https://www.geodata.rocks/voc/css/investigation_method/top_concept> ;
    skos:definition "Seismic waves are generated by a controlled source at the surface and travel downwards until their energy is deflected at a velocity boundary in the subsurface (e.g. water table, an interface between different rock types). When the lower-layer velocity exceeds the upper-layer velocity, the deflected wave travels along the bottom of the impedance boundary, generating refracted waves along its path that can be recorded at the surface by sensors."@en ;
    skos:inScheme <https://www.geodata.rocks/voc/css/investigation_method> ;
    skos:prefLabel "seismic refraction"@en .

<https://www.geodata.rocks/voc/css/investigation_method> a skos:ConceptScheme ;
    dct:title "Investigation Method"@en ;
    skos:hasTopConcept <https://www.geodata.rocks/voc/css/investigation_method/top_concept> ;
    skos:prefLabel "Investigation Method"@en .

<https://www.geodata.rocks/voc/css/investigation_method/top_concept> a skos:Concept ;
    skos:narrower <https://www.geodata.rocks/voc/css/investigation_method/multi_channel_analysis_of_surface_waves>,
        <https://www.geodata.rocks/voc/css/investigation_method/near_surface_seismics>,
        <https://www.geodata.rocks/voc/css/investigation_method/seismic_reflection>,
        <https://www.geodata.rocks/voc/css/investigation_method/seismic_refraction>,
        <https://www.geodata.rocks/voc/css/investigation_method/wide_angle_reflection_and_refraction> ;
    skos:prefLabel "Investigation Method"@en ;
    skos:topConceptOf <https://www.geodata.rocks/voc/css/investigation_method> .

